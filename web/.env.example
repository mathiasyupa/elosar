# Base URL of the medico-backend host (without the /api/v1 suffix).
# The API client appends /api/v1 automatically.
VITE_API_URL=http://localhost

# --- Commercial contact ------------------------------------------------------
# Generic WhatsApp link a workspace uses to ask for activation once its trial
# ends. Must be plain https (e.g. https://wa.me/5939XXXXXXXX) and carry no
# name, workspace, clinical or fiscal data in the URL.
#
# Leave EMPTY in development. When it is unset the app renders no link at all
# rather than a broken one — which also means that if it is missing in Vercel,
# a doctor whose trial expired sees the read-only notice with no way to reach
# you, and nothing in the build warns about it.
VITE_ELOSAR_COMMERCIAL_WHATSAPP_URL=

# --- Error monitoring (optional) ---------------------------------------------
# Sentry DSN. Leave EMPTY in development and in any public checkout: without it
# the SDK is never loaded, nothing is sent, and no DSN ends up in the bundle.
# Set it only in the Vercel production environment.
VITE_SENTRY_DSN=
# Label shown on Sentry issues. Defaults to Vite's mode when unset.
VITE_SENTRY_ENV=production
